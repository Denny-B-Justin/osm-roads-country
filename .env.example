# Databricks workspace (same values as the Country Benchmarking Dashboard). No SQL warehouse
# or HTTP path is needed: the app only reads files from the Volume.
DATABRICKS_SERVER_HOSTNAME= "adb-xxxx.azuredatabricks.net"
DATABRICKS_CLIENT_ID= "YOUR_CLIENT_ID_HERE"
DATABRICKS_CLIENT_SECRET= "YOUR_CLIENT_SECRET_HERE"

# Folder the zip notebook writes to (this is the default).
ROADS_VOLUME_DIR= "/Volumes/prd_mega/sgpbpi163/vgpbpi163/OSM/osm_road_all_country"

# How often the app re-reads manifest.json, in seconds.
MANIFEST_TTL_SECONDS= 600

# Development only: serve a local folder instead of the Volume (python dev/make_mock_data.py).
# ROADS_LOCAL_DIR= "dev/mock_volume"
